{
  "name": "japanese-suburb-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Procedural generation of a modern Japanese suburb (houses, apartments, mansions) in TypeScript + Three.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "shot": "node tools/screenshot.mjs"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "polygon-clipping": "^0.15.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
